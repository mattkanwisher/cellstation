diff --git a/rpcs3/Emu/RSX/VK/vkutils/swapchain_core.h b/rpcs3/Emu/RSX/VK/vkutils/swapchain_core.h
index aaf8426..5771356 100644
--- a/rpcs3/Emu/RSX/VK/vkutils/swapchain_core.h
+++ b/rpcs3/Emu/RSX/VK/vkutils/swapchain_core.h
@@ -56,6 +56,13 @@ namespace vk
 		virtual void destroy(bool full = true) = 0;
 		virtual bool init() = 0;
 
+		// Surface replacement after surface loss. Some WMs (Android) destroy the
+		// native window of a backgrounded application; the VkSurfaceKHR created
+		// on it is then permanently lost and a replacement must be adopted before
+		// the swapchain can be rebuilt. No-ops for surfaceless implementations.
+		virtual void drop_surface() {}
+		virtual void set_surface(VkSurfaceKHR) {}
+
 		virtual u32 get_swap_image_count() const = 0;
 		virtual VkImage get_image(u32 index) = 0;
 		virtual VkResult acquire_next_swapchain_image(VkSemaphore semaphore, u64 timeout, u32* result) = 0;
@@ -189,6 +196,24 @@ namespace vk
 
 		void destroy(bool = true) override;
 
+		// The swapchain is destroyed with the surface: it references the dead
+		// surface and cannot serve as oldSwapchain for the replacement.
+		void drop_surface() override
+		{
+			if (m_vk_swapchain)
+			{
+				_vkDestroySwapchainKHR(dev, m_vk_swapchain, nullptr);
+				m_vk_swapchain = VK_NULL_HANDLE;
+			}
+
+			m_surface = VK_NULL_HANDLE;
+		}
+
+		void set_surface(VkSurfaceKHR surface) override
+		{
+			m_surface = surface;
+		}
+
 		std::pair<VkSurfaceCapabilitiesKHR, bool> init_surface_capabilities();
 
 		using WSI_swapchain_base::init;
